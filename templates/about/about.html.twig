
{% extends 'base.html.twig' %}

{% block title %}À propos{% endblock %}

{% block body %}
    <section class="max-w-2xl mx-auto mt-10 bg-slate-500 p-6 rounded-lg shadow-lg shadow-red-600">
        <h1 class="text-2xl font-bold mb-4">À propos de Todo List</h1>
        <p class="mb-2">
            Bienvenue sur notre site Todo List. Ici, vous pouvez créer, modifier et supprimer vos tâches facilement.
