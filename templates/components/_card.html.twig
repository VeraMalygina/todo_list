<article
    draggable="true"
    data-task-id="{{ oneTask.id }}"
    class="bg-slate-50 border border-slate-200 rounded-lg p-3 hover:shadow cursor-grab active:cursor-grabbing active:scale-90 active:shadow-2xl transition-all"
>
    <h4>{{ oneTask.title }}</h4>
    <p class="text-slate-500 text-xs mt-1">{{ oneTask.description }}</p>

    <footer
        class="flex justify-between items-center mt-3 text-xs text-slate-500"
    >
        <span>Assigné à : Marie</span>
        <span>💬 2</span>
    </footer>
</article>
