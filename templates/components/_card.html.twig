<article
    draggable="true"
    data-task-id="{{ oneTask.id }}"
    data-task="card"
    data-title="{{ oneTask.title }}"
    data-description="{{ oneTask.description }}"
    data-due-date="{{ oneTask.dueDate|date('Y-m-d') }}"
    class="bg-slate-50 border border-slate-200 relative rounded-lg p-3 hover:shadow cursor-grab active:cursor-grabbing active:scale-90 active:shadow-2xl transition-all"
>
    <h4 class="break-words whitespace-normal pr-16 text-md text-black">{{ oneTask.title }}</h4>
    <p class="text-slate-500 text-xs mt-1 break-words whitespace-normal">
        {{ oneTask.description }}
    </p>

   
    {% if oneTask.author.id == app.user.id %}
        <button
            class="h-6 w-6 absolute top-2 right-12 text-stone-950 transition-all duration-300 ease-out hover:text-zinc-400"
            data-edit
            type="button"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-6"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"
                />
            </svg>
        </button>

        <button
            class="h-6 w-6 absolute top-2 right-4 text-stone-950 transition-all duration-300 ease-out hover:text-red-700"
            
            data-action="delete-task"
            type="button"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-6"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"
                />
            </svg>
        </button>
    {% endif %}

    <footer
        class="flex justify-between items-center mt-3 gap-2 text-xs text-slate-500"
    >
        <span>Assigné à : {{ oneTask.author.name }}</span>
        <span>Date de creation : {{ oneTask.createdAt|date('d.m.Y')}}</span>
        <span>Deadline : {{ oneTask.dueDate|date('d.m.Y') }}</span>


        {% if oneTask.author.avatar %} 
            <img
                src="{{ asset('uploads/avatars/' ~ (oneTask.author.avatar ?? 'default-avatar.png')) }}"
                alt="Avatar de {{ oneTask.author.username }}"
                

            >
        {%else%} 

            <svg class="w-8 h-8 text-slate-600" aria-hidden="true" xmlns="http://www.w3. org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 20a7.966 7.966 0 0 1-5.002-1.756l.002.001v-.683c0-1.794 1.492-3.25 3.333-3.25h3.334c1.84 0 3.333 1.456 3.333 3.25v.683A7.966 7.966 0 0 1 12 20ZM2 12C2 6.477 6.477 2 12 2s10 4.477 10 10c0 5.5-4.44 9.963-9.932 10h-.138C6.438 21.962 2 17.5 2 12Zm10-5c-1.84 0-3.333 1.455-3.333 3.25S10.159 13.5 12 13.5c1.84 0 3.333-1.455 3.333-3.25S13.841 7 12 7Z" clip-rule="evenodd"/>
            </svg>
        {%endif%}

    </footer>
</article>


