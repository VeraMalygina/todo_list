<div
    data-sheet-overlay
    class="fixed inset-0 z-[2000] hidden bg-[rgb(31,39,49)]/40 duration-300 backdrop-blur-md"
></div>

<div
    data-sheet-panel
    style="display: none"
    class="fixed top-0 right-0 h-full w-full max-w-96 bg-[rgb(31,39,49)] flex flex-col gap-4 bg-clip-padding text-sm shadow-lg translate-x-full transition duration-700 ease-in-out z-[2001] overflow-y-auto"
>
    <div class="flex flex-col gap-0.5 p-4 mt-10">
        <h2 class="font-medium text-base md:text-lg">Créer une tâche</h2>
    </div>
    <form
        id="task-form"
        class="flex flex-col flex-1 auto-rows-min gap-6 px-4 pb-4"
    >
        <div class="grid gap-3">
            <label
                class="flex items-center gap-2 text-sm leading-none font-medium select-none peer-disabled:cursor-not-allowed peer-disabled:opacity-50"
                for="sheet-demo-name"
                >Title</label
            ><input
                class="dark:bg-input/30 border-input g aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 disabled:bg-input/50 dark:disabled:bg-input/80 file:text-foreground placeholder:text-muted-foreground h-8 w-full min-w-0 rounded-lg border bg-transparent px-2.5 py-1 transition-colors outline-none file:inline-flex file:h-6 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:ring-[3px] md:text-sm focus:shadow-white focus:shadow-sm"
                id="sheet-demo-name"
                placeholder="Title"
                name="title"
            />
            <label
                class="flex items-center gap-2 text-sm leading-none font-medium select-none peer-disabled:cursor-not-allowed peer-disabled:opacity-50"
                for="sheet-description"
                >Description</label
            ><textarea
                class="dark:bg-input/30 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 disabled:bg-input/50 dark:disabled:bg-input/80 file:text-foreground placeholder:text-muted-foreground min-h-28 w-full min-w-0 rounded-lg border bg-transparent px-2.5 py-1 transition-colors outline-none file:inline-flex file:h-6 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:ring-[3px] md:text-sm focus:shadow-white focus:shadow-sm"
                id="sheet-description"
                placeholder="Entrez une description"
                name="description"
            ></textarea>
        </div>
        <div class="grid gap-3">
            <label
                class="flex items-center gap-2 text-sm leading-none font-medium select-none peer-disabled:cursor-not-allowed peer-disabled:opacity-50"
                for="sheet-date"
                >Deadline</label
            >
            <input
                type="date"
                name="dueDate"
                value="{{ 'now' |date('Y-m-d')}}"
                id="sheet-date"
                class="border rounded p-2 bg-transparent focus:shadow-white focus:shadow-sm"
            />
        </div>
        <input
            type="hidden"
            name="_token"
            value="{{ csrf_token('create_task') }}"
        />

        <div class="mt-auto flex flex-col gap-2">
            <button
                class="bg-transparent border border-neutral-950 px-2.5 py-1.5 rounded-lg text-sm font-medium hover:bg-[rgb(18,27,39)] hover:-translate-y-0.5 hover:shadow-xl transition-all duration-600 text-center"
                type="submit"
            >
                Enregistrer</button
            ><button
                data-sheet-close
                class="bg-transparent border border-neutral-950 px-2.5 py-1.5 rounded-lg text-sm font-medium hover:bg-[rgb(18,27,39)] hover:-translate-y-0.5 hover:shadow-xl transition-all duration-600"
                type="button"
            >
                Fermer
            </button>
        </div>
    </form>

    <button
        data-sheet-close
        class=" focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 border border-transparent bg-clip-padding text-sm font-medium focus-visible:ring-[3px] aria-invalid:ring-[3px] [&amp;_svg:not([class*='size-'])]:size-4 inline-flex items-center justify-center whitespace-nowrap transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none shrink-0 [&amp;_svg]:shrink-0 outline-none group/button select-none hover:bg-muted hover:text-foreground dark:hover:bg-muted/50 aria-expanded:bg-muted aria-expanded:d size-7 rounded-[min(var(--radius-md),12px)] absolute top-3 right-3 hover:scale-125 duration-300 ease-in-out"
        type="button"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path></svg
        ><span class="sr-only">Close</span>
    </button>
</div>
