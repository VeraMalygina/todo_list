<div
    data-edit-overlay
    class="fixed inset-0 z-40 bg-slate-100/20 duration-300 backdrop-blur-sm hidden"
>
    <div
        class="fixed z-50 top-1/2 left-1/2 grid w-full max-w-[calc(100%-2rem)] -translate-x-1/2 -translate-y-1/2 gap-4 rounded-xl bg-slate-950/20 p-4 text-sm text-black ring-1 ring-foreground/10 outline-none sm:max-w-sm duration-300 backdrop-blur-md"
        tabindex="-1"
        style="pointer-events: auto"
    >
        <div class="flex flex-col gap-2 mt-9 mb-3">
            <h2 class="text-base leading-none font-medium">
                Modifier la tâche
            </h2>
            <p
                class="text-sm text-muted-foreground *:[a]:underline *:[a]:underline-offset-3 *:[a]:hover:text-foreground"
            >
                Modifier votre tâche ici. Cliquez sur « Enregistrer » lorsque
                vous avez terminé.
            </p>
        </div>
        <form id="edit-form">
            <div
                class="group/field-group @container/field-group flex w-full flex-col gap-5"
            >
                <div
                    class="group/field flex w-full gap-2 flex-col *:w-full [&amp;&gt;.sr-only]:w-auto"
                >
                    <input type="hidden" name="_token" value="{{csrf_token('edit-task')}}">
                    
                    <input type="hidden" name="taskId">
                    <label
                        class="flex items-center gap-2 text-sm leading-none font-medium select-none peer-disabled:cursor-not-allowed peer-disabled:opacity-50"
                        for="name"
                        >Title</label
                    ><input
                        class="dark:bg-input/30 border-input focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 disabled:bg-input/50 dark:disabled:bg-input/80 file:text-foreground placeholder:text-muted-foreground h-8 w-full min-w-0 rounded-lg border bg-transparent px-2.5 py-1 text-base transition-colors outline-none file:inline-flex file:h-6 file:border-0 file:bg-transparent file:text-sm file:font-medium focus-visible:ring-[3px] disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:ring-[3px] md:text-sm"
                        id="name"
                        placeholder="Title"
                        name="title"
                    />
                </div>
                <div
                    class="group/field flex w-full gap-2 flex-col *:w-full [&amp;&gt;.sr-only]:w-auto"
                >
                    <label
                        class="flex items-center gap-2 text-sm leading-none font-medium select-none peer-disabled:cursor-not-allowed peer-disabled:opacity-50"
                        for="description"
                        >Description</label
                    ><textarea
                        class="dark:bg-input/30 border-input focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 disabled:bg-input/50 dark:disabled:bg-input/80 file:text-foreground placeholder:text-muted-foreground min-h-28 w-full min-w-0 rounded-lg border bg-transparent px-2.5 py-1 text-base transition-colors outline-none file:inline-flex file:h-6 file:border-0 file:bg-transparent file:text-sm file:font-medium focus-visible:ring-[3px] disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:ring-[3px] md:text-sm"
                        id="description"
                        placeholder="Entrez une description"
                        name="description"
                    ></textarea>
                </div>

                <div
                    class="group/field flex w-full gap-3 flex-col *:w-full [&amp;&gt;.sr-only]:w-auto text-black mb-3"
                >
                    <label
                        class="flex items-center gap-2 text-sm leading-none font-medium select-none peer-disabled:cursor-not-allowed peer-disabled:opacity-50"
                        for="date"
                        >Deadline</label
                    >
                    <input
                        type="date"
                        name="dueDate"
                        value="{{ 'now' |date('Y-m-d')}}"
                        id="date"
                        class="border rounded p-2 bg-slate-200"
                    />
                </div>
            </div>
            <div
                class="-mx-4 -mb-4 flex flex-col-reverse gap-2 rounded-b-xl border-t bg-slate-500 p-4 sm:flex-row sm:justify-end"
            >
                <button
                    data-close-edit
                    class="group/button inline-flex shrink-0 items-center justify-center rounded-lg border bg-clip-padding text-sm font-medium whitespace-nowrap outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 ark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 border-border bg-background hover:bg-muted hover:text-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50 h-8 gap-1.5 px-2.5 transition-all duration-200 ease-out hover:bg-slate-700/25 hover:-translate-y-0.5 hover:shadow-xl"
                    type="button"
                >
                    Annuler</button
                ><button
                    data-confirm-edit
                    class="group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-sky-50 text-sm text-slate-900 font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 bg-primary text-primary-foreground [a]:hover:bg-primary/80 h-8 gap-1.5 px-2.5 duration-200 ease-out hover:-translate-y-0.5 hover:shadow-xl"
                    type="submit"
                >
                    Enregistrer
                    <span data-spinner-edit class="loading loading-ring loading-lg hidden"></span>
                </button>
            </div>
        </form>

        <button
            data-close-edit
            class="group/button inline-flex shrink-0 items-center justify-center border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 size-7 rounded-[min(var(--radius-md),12px)] absolute top-2 right-2 duration-500 ease-out hover:ring-1 hover:ring-black"
            type="button"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-x"
            >
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path></svg
            ><span class="sr-only">Close</span>
        </button>
    </div>
</div>
