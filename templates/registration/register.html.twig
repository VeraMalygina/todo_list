{% extends 'background_layout/layout.html.twig' %}

    {% block title %}Inscription{% endblock %}

    {% block content %}
    



    

    {% for flash_error in app.flashes('verify_email_error') %}
    <div class="bg-red-100 text-red-700 p-3 rounded mb-4" role="alert">{{ flash_error }}</div>
    {% endfor %}

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm, { attr: { class: ' max-w-md mx-auto  space-y-4' } }) }}
        {{ form_row(registrationForm.name, {
            label: 'Prenom',
            attr: {
                class: 'w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400'
            }
        }) }}

        {{ form_row(registrationForm.email, {
            label: 'E-mail',
            attr: {
                class: 'w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400'
            }
        }) }}

        {{ form_row(registrationForm.plainPassword, {
            label: 'Mot de passe',
            attr: {
                class: 'w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400'
            }
        }) }}

        {{ form_row(registrationForm.avatar, {
            
            attr: {
                class: 'pl-2'
            }
        }) }}

        <div class='flex '> 
            {{ form_label(registrationForm.agreeTerms, 'J’accepte les conditions', {
                'label_attr': {'class': ' flex items-center justify-center text-center'}
            }) }}
            {{ form_widget(registrationForm.agreeTerms, {
                'attr': {'class': 'ml-2 flex items-center justify-center mt-1'}
            }) }}
        </div>
        

        <button type="submit" class="w-full bg-green-500  py-2 rounded-lg hover:bg-green-600 transition">S’inscrire</button>
    {{ form_end(registrationForm) }}
    
    
{% endblock %}


