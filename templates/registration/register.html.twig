{% extends 'background_layout/layout.html.twig' %}

    {% block title %}Inscription{% endblock %}

    {% block content %}
    



    <div class="flex flex-col w-full max-w-[420px]  gap-3 mt-14 mb-14" data-page="registration"> 


        <h2 class="text-2xl font-bold sm:text-3xl  text-center">Bienvenue sur Liste de tâches</h2>

        <p class="text-base sm:text-lg text-center "> Commencez gratuitement. Sans carte bancaire.</p>
        
        {% for flash_error in app.flashes('verify_email_error') %}
        <div class="bg-red-100 text-red-700 p-3 rounded mb-4" role="alert">{{ flash_error }}</div>
        {% endfor %}

        
        

        {{ form_start(registrationForm, { attr: { 
                    class: 'w-full mx-auto  space-y-4',
                    'id': 'registration-form',
                } 
            }) }}

            

            <div>
                {{ form_label(registrationForm.name, null, {
                    'label': 'Prenom',
                    'label_attr': {'class': 'block mb-2'}
                
                }) }}
                {{ form_widget(registrationForm.name, {
                    attr: {
                    'class': 'w-full p-2 border rounded-lg bg-[#78808e]/70 focus:bg-[#78808e]/70 focus:outline-none focus:ring-2  focus:ring-sky-950 '
                    }
                }) }}
                <div class="text-xs text-red-700  mb-4 ">
                    {{ form_errors(registrationForm.name) }}
                </div>

            </div>



            <div>
                {{ form_label(registrationForm.email, null, {
                    'label': 'E-mail',
                    'label_attr': {'class': 'block mb-2'}
                
                }) }}
                {{ form_widget(registrationForm.email, {
                    attr: {
                    'class': 'w-full p-2 border rounded-lg bg-[#78808e]/70 focus:bg-[#78808e]/70 focus:outline-none focus:ring-2  focus:ring-sky-950 '
                    }
                }) }}
                <div class="text-xs text-red-700  mb-4 ">
                    {{ form_errors(registrationForm.email) }}
                </div>

            </div>


            <div>
                {{ form_label(registrationForm.plainPassword, null, {
                    'label': 'Mot de passe',
                    'label_attr': {'class': 'block mb-2'}
                
                }) }}
                {{ form_widget(registrationForm.plainPassword, {
                    attr: {
                    'class': 'w-full p-2 border rounded-lg bg-[#78808e]/70 focus:bg-[#78808e]/70 focus:outline-none focus:ring-2  focus:ring-sky-950 '
                    }
                }) }}
                <div class="text-xs text-red-700  mb-4 ">
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>

            </div>


            
            <div>
                {{ form_label(registrationForm.avatar, null, {
                    'label': 'Avatar',
                    'label_attr': {'class': 'block mb-2'}
                
                }) }}
                {{ form_widget(registrationForm.avatar, {
                    attr: {
                        'data-avatar': 'avatar',
                        'data-max-size': '2097152',
                        'class': 'w-full p-2 border rounded-lg bg-[#78808e]/70 focus:bg-[#78808e]/70 focus:outline-none focus:ring-2  focus:ring-sky-950 '
                    }
                }) }}
                <div class="text-xs text-red-700  mb-4 ">
                    {{ form_errors(registrationForm.avatar) }}
                </div>

            </div>


            

            <div class='flex flex-col '> 
                {{ form_label(registrationForm.agreeTerms, 'J’ai lu et j’accepte la Politique de confidentialité.', {
                    'label_attr': {'class': 'text-xs'}
                }) }}
                <div class="flex">
                    <a href="{{path('privacy')}}" class="text-xs underline underline-offset-2 hover:text-[rgb(18,27,39)]">Politique de confidentialité </a>
                    {{ form_widget(registrationForm.agreeTerms, {
                        'attr': {'class': 'ml-2 mt-1 '}
                    }) }}
                </div>
                
            </div>
            

            <button type="submit" class="w-full py-2 rounded-lg bg-[rgb(18,27,39)] hover:bg-[rgb(11,30,52)] transition">S’inscrire</button>
        {{ form_end(registrationForm) }}
    

            
        <div class="flex gap-1 justify-center items-center mt-2">
            <p>Vous avez déjà un compte ? </p>
            <a href="{{path('app_login')}}" class="underline underline-offset-2 hover:text-[rgb(18,27,39)]">Connexion </a>
            
        </div>
                 

                
            

    </div>
    

    
{% endblock %}


