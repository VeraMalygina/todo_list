{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="bg-red-100 text-red-700 p-3 rounded mb-4" role="alert">{{ flash_error }}</div>
    {% endfor %}



    
    
    {{dump(app)}}
    {{dump(app.flashes)}}
    <h1>Register</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm, { attr: { class: 'max-w-md mx-auto mt-10 space-y-4' } }) }}
         {{ form_row(registrationForm.name, {
            attr: {
                class: 'w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400'
            }
        }) }}

        {{ form_row(registrationForm.email, {
            attr: {
                class: 'w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400'
            }
        }) }}

        {{ form_row(registrationForm.plainPassword, {
            label: 'Password',
            attr: {
                class: 'w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400'
            }
        }) }}

        {{ form_row(registrationForm.agreeTerms, {
            attr: {
                class: 'mr-2'
            }
        }) }}

        <button type="submit" class="w-full bg-green-500 text-white py-2 rounded-lg hover:bg-green-600 transition">Register</button>
    {{ form_end(registrationForm) }}
{% endblock %}


