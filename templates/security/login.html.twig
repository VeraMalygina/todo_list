{% extends 'background_layout/layout.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block content %}

   <section class="flex z-[30] flex-col gap-6 w-full max-w-[420px]">

        <h1 class="text-4xl md:text-5xl  font-bold text-center">Veuillez vous connecter</h1>

        <form action="{{ path('app_login') }}"  method="post" class="w-full mx-auto space-y-4 opacity-100  ">
            
                 
            
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <label for="username" class="block text-sm font-medium">Email</label>
            <input 
                type="email" 
                value="{{ last_username }}" 
                name="_username" 
                id="username" 
                class=" bg-[#78808e]/70 w-full p-2 border rounded-lg focus:bg-[#78808e]/70 focus:ring-2 focus:outline-none focus:ring-sky-950 active:bg-none" 
                autocomplete="email" 
                required 
                autofocus
            >

            <label for="password" class="block text-sm font-medium ">Mot de passe</label>
            <input 
                type="password" 
                name="_password" 
                id="password" 
                class="bg-[#78808e]/70 w-full p-2 border rounded-lg focus:bg-[#78808e]/70 focus:outline-none focus:ring-2  focus:ring-sky-950" 
                autocomplete="current-password" 
                required
            >

            <input 
                type="hidden" 
                name="_csrf_token" 
                data-controller="csrf-protection" 
                value="{{ csrf_token('authenticate') }}"
            >

            {#
                <div class="flex items-center gap-2 ">
                    <input type="checkbox" name="_remember_me" id="_remember_me">
                    <label for="_remember_me" class="text-sm">Remember me</label>
                </div>
            #}


            {% if error %}
                <div class=" text-red-700 p-3 rounded">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <button 
                class="w-full bg-[rgb(18,27,39)] py-2 rounded-lg mt-5 hover:bg-[rgb(11,30,52)] hover:translate-y-0.5 transition-all duration-600 " 
                type="submit"
            >
                Se connecter
            </button>

            
        </form>

        <div class="flex flex-col sm:flex-row  sm:gap-1 justify-center items-center">
            <p >Vous n'avez pas encore de compte ?</p>
            <a href="{{ path('app_register') }}" class="underline underline-offset-2 hover:text-[rgb(18,27,39)]">S’inscrire</a>
        </div>

   </section>
        
        
   
    
{% endblock %}




