{% extends 'base.html.twig' %}  {%
block body %}
<section data-page="tasks" class="min-h-screen bg-slate-100 px-4 py-6">
    <header>
        <h2 class="text-2xl font-semibold text-slate-950 mb-6">Mes tâches</h2>
    </header>
        {{ dump(app.user.roles) }}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 ">
        <!-- COLONNE : À FAIRE -->
        <section
            data-status="todo"
            data-dropzone="true"
            class="bg-white rounded-xl shadow-sm p-4 flex flex-col "
        >
            <header class="flex items-center justify-between mb-4">
                <h3 class=" text-slate-700  font-medium">À faire</h3>
                <div class="flex items-center justify-center gap-2">
                    <span
                        data-counter
                        class="text-sm bg-slate-200 text-slate-600 px-2 py-0.5 rounded-full "
                        >3</span
                    >

                    <button
                        data-sheet-open
                        type="button"
                        class="relative group w-8 h-8 flex items-center justify-center rounded-full text-black transition-all divide-purple-300 ease-out hover:text-lime-400"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" 
                            fill="none" 
                            viewBox="0 0 24 24" 
                            stroke-width="1.5" 
                            stroke="currentColor" 
                            class="size-8">
                            <path stroke-linecap="round" 
                                  stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                            />
                        </svg>


                        <span
                            class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-2 opacity-0 whitespace-nowrap rounded-md bg-blue-600 px-2 py-1 text-xs text-white transition-all duration-300 ease-out group-hover:opacity-100 group-hover:translate-y-0 "
                        >
                            Ajouter une tache
                        </span>
                    </button>
                </div>
            </header>

            <div
                data-task-wrapper
                class="flex flex-col gap-3 max-h-[70vh] overflow-y-auto overflow-x-visible"
            >
                {% for oneTask in todoTasks %} {% include
                'components/_card.html.twig' with { task: oneTask} %} {% endfor
                %}
            </div>
        </section>

        <!-- COLONNE : EN COURS -->
        <section
            data-status="in_progress"
            data-dropzone="true"
            class="bg-white rounded-xl shadow-sm p-4 flex flex-col"
        >
            <header class="flex item-center justify-between mb-4">
                <h3 class="text-slate-700 font-medium">En cours</h3>
                <div class="flex items-center justify-center gap-2">
                    <span
                        data-counter
                        class="text-sm bg-slate-200 text-slate-600 px-2 py-0.5 rounded-full"
                        >1</span
                    >
                </div>
            </header>

            <div
                data-task-wrapper
                class="flex flex-col gap-3 max-h-[70vh] overflow-y-auto overflow-x-visible"
            >
                {% for oneTask in inProgressTasks %} {% include
                'components/_card.html.twig' with { task: oneTask} %} {% endfor
                %}
            </div>
        </section>

        <!-- COLONNE : TERMINÉ -->
        <section
            data-status="done"
            data-dropzone="true"
            class="bg-white rounded-xl shadow-sm p-4 flex flex-col"
        >
            <header class="flex items-center justify-between mb-4">
                <h3 class="text-slate-700 font-medium">Terminé</h3>
                <div class="flex items-center gap-2">
                    <span
                        data-counter
                        class="text-sm bg-slate-200 text-slate-600 px-2 py-0.5 rounded-full"
                        >2</span
                    >
                </div>
            </header>

            <div
                data-task-wrapper
                class="flex flex-col gap-3 max-h-[70vh] overflow-y-auto overflow-x-visible"
            >
                {% for oneTask in doneTasks %} {% include
                'components/_card.html.twig' with { task: oneTask} %} {% endfor
                %}
            </div>
        </section>
    </div>
</section>


{% include 'components/_create_task_sheet.html.twig' %}

{% include 'components/_modal_delete.html.twig' %}

{% include 'components/_confirmation_and_notification.html.twig' %}

{% include 'components/_modal_edit.html.twig' %}



{% endblock %}
