{% extends 'background_layout/layout.html.twig' %} 
{% block content %}


<style>
    [data-page="tasks"] [data-task="card"] {
        background: rgba(30, 38, 49, 0.92) !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        border-radius: 0.5rem !important;
        padding: 0.75rem !important;
        position: relative !important;
        user-select: none !important;
        -webkit-user-select: none !important;
        transition: all 150ms ease !important;
    }

    [data-page="tasks"] [data-task="card"] h4 {
        word-break: break-word;
        white-space: normal;
        padding-right: 7rem;
        font-size: 1.125rem;
        line-height: 1.75rem;
    }

    [data-page="tasks"] [data-task="card"] p {
        margin-top: 0.25rem;
        word-break: break-word;
        white-space: normal;
        font-size: 1rem;
        line-height: 1.5rem;
    }
</style>


<section data-page="tasks" class=" bg-[rgba(30,38,49,0.5)] border-spacing-x-32 backdrop-blur-sm w-full px-3 py-6 mt-16 rounded-lg z-[30] 2xl:backdrop-blur-none">
   
        
    <div data-board class="flex gap-5 overflow-x-auto md:grid md:grid-cols-3 md:gap-5 md:overflow-visible ">

        <!-- COLONNE : À FAIRE -->
        <section
            data-column
            class="min-w-[86vw] rounded-xl shadow-sm p-4 flex flex-col min-h-[50vh] md:min-w-0 md:min-h-[100vh]"
        >
            <header class="flex items-center justify-between mb-4 min-h-8">
                <h3 class="uppercase tracking-[0.25em] ">À faire</h3>
                <div class="flex items-center justify-center gap-2">
                    <span
                        data-counter
                        class="text-sm color-[#373E47]  px-2 py-0.5 rounded-full "
                        >3</span
                    >

                    <button
                        data-sheet-open
                        type="button"
                        class="relative group w-8 h-8 flex items-center justify-center rounded-full  transition-all divide-purple-300 ease-out hover:text-current hover:scale-110 duration-300"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" 
                            fill="none" 
                            viewBox="0 0 24 24" 
                            stroke-width="1.5" 
                            stroke="currentColor" 
                            class="size-8">
                            <path stroke-linecap="round" 
                                  stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                            />
                        </svg>


                        <span
                            class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-2 opacity-0 whitespace-nowrap rounded-md bg-[rgb(30,38,49)] px-2 py-1 text-xs  transition-all duration-300 ease-out group-hover:opacity-100 group-hover:translate-y-0 "
                        >
                            Ajouter une tache
                        </span>
                    </button>
                </div>
            </header>

            <div
                data-task-wrapper
                data-status="todo"
                class="flex flex-col gap-3 h-full"
            >
                {% for oneTask in todoTasks %} {% include
                'components/_card.html.twig' with { task: oneTask} %} {% endfor
                %}
            </div>
        </section>

        <!-- COLONNE : EN COURS -->
        <section
            
            data-column
            class="min-w-[86vw] rounded-xl shadow-sm p-4 flex flex-col min-h-[50vh] md:min-w-0 md:min-h-[100vh]"
        >
            <header class="flex justify-between items-center mb-4 min-h-8">
                <h3 class="uppercase tracking-[0.25em]">En cours</h3>
                <div class="flex items-center justify-center gap-2">
                    <span
                        data-counter
                        class="text-sm color-[#373E47]  px-2 py-0.5 rounded-full"
                        >1</span
                    >
                </div>
            </header>

            <div
                data-task-wrapper
                data-status="in_progress"
                class="flex flex-col gap-3 h-full"
            >
                {% for oneTask in inProgressTasks %} {% include
                'components/_card.html.twig' with { task: oneTask} %} {% endfor
                %}
            </div>
        </section>

        <!-- COLONNE : TERMINÉ -->
        <section
            
            data-column
            class="min-w-[86vw] rounded-xl shadow-sm p-4 flex flex-col min-h-[50vh] md:min-w-0 md:min-h-[100vh]"
        >
            <header class="flex items-center justify-between mb-4 min-h-8">
                <h3 class="uppercase tracking-[0.25em]">Terminé</h3>
                <div class="flex items-center gap-2">
                    <span
                        data-counter
                        class="text-sm color-[#373E47]  px-2 py-0.5 rounded-full"
                        >2</span
                    >
                </div>
            </header>

            <div
                data-task-wrapper
                data-status="done"
                class="flex flex-col gap-3 h-full"
            >
                {% for oneTask in doneTasks %} {% include
                'components/_card.html.twig' with { task: oneTask} %} {% endfor
                %}
            </div>
        </section>
    </div>
</section>



    {% include 'components/_create_task_sheet.html.twig' %}
    
    {% include 'components/_modal_delete.html.twig' %}
    {% include 'components/_modal_edit.html.twig' %}




{% endblock %}
