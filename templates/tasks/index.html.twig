{% extends 'background_layout/layout.html.twig' %} 
{% block content %}
<section data-page="tasks" class="min-h-[calc(100dvh-4rem)] bg-[rgb(30,38,49)]/50 backdrop-blur-sm w-full px-3 py-6 mt-16 rounded-lg 2xl:backdrop-blur-none">
   
        
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 ">

        <!-- COLONNE : À FAIRE -->
        <section
            data-status="todo"
            data-dropzone="true"
            class="bg-[rgb(30,38,49)]/55 rounded-xl shadow-sm p-4 flex flex-col"
        >
            <header class="flex items-center justify-between mb-4 min-h-8">
                <h3 class="   font-medium">À faire</h3>
                <div class="flex items-center justify-center gap-2">
                    <span
                        data-counter
                        class="text-sm color-[#373E47]  px-2 py-0.5 rounded-full "
                        >3</span
                    >

                    <button
                        data-sheet-open
                        type="button"
                        class="relative group w-8 h-8 flex items-center justify-center rounded-full  transition-all divide-purple-300 ease-out hover:text-current hover:scale-110 duration-300"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" 
                            fill="none" 
                            viewBox="0 0 24 24" 
                            stroke-width="1.5" 
                            stroke="currentColor" 
                            class="size-8">
                            <path stroke-linecap="round" 
                                  stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                            />
                        </svg>


                        <span
                            class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-2 opacity-0 whitespace-nowrap rounded-md bg-[rgb(30,38,49)] px-2 py-1 text-xs  transition-all duration-300 ease-out group-hover:opacity-100 group-hover:translate-y-0 "
                        >
                            Ajouter une tache
                        </span>
                    </button>
                </div>
            </header>

            <div
                data-task-wrapper
                class="flex flex-col gap-3 "
            >
                {% for oneTask in todoTasks %} {% include
                'components/_card.html.twig' with { task: oneTask} %} {% endfor
                %}
            </div>
        </section>

        <!-- COLONNE : EN COURS -->
        <section
            data-status="in_progress"
            data-dropzone="true"
            class="bg-[rgb(30,38,49)]/55 rounded-xl shadow-sm p-4 flex flex-col "
        >
            <header class="flex justify-between items-center mb-4 min-h-8">
                <h3 class=" font-medium">En cours</h3>
                <div class="flex items-center justify-center gap-2">
                    <span
                        data-counter
                        class="text-sm color-[#373E47]  px-2 py-0.5 rounded-full"
                        >1</span
                    >
                </div>
            </header>

            <div
                data-task-wrapper
                class="flex flex-col gap-3  "
            >
                {% for oneTask in inProgressTasks %} {% include
                'components/_card.html.twig' with { task: oneTask} %} {% endfor
                %}
            </div>
        </section>

        <!-- COLONNE : TERMINÉ -->
        <section
            data-status="done"
            data-dropzone="true"
            class="bg-[rgb(30,38,49)]/55 rounded-xl shadow-sm p-4 flex flex-col"
        >
            <header class="flex items-center justify-between mb-4 min-h-8">
                <h3 class=" font-medium">Terminé</h3>
                <div class="flex items-center gap-2">
                    <span
                        data-counter
                        class="text-sm color-[#373E47]  px-2 py-0.5 rounded-full"
                        >2</span
                    >
                </div>
            </header>

            <div
                data-task-wrapper
                class="flex flex-col gap-3 "
            >
                {% for oneTask in doneTasks %} {% include
                'components/_card.html.twig' with { task: oneTask} %} {% endfor
                %}
            </div>
        </section>
    </div>
</section>



    {% include 'components/_create_task_sheet.html.twig' %}
    
    {% include 'components/_modal_delete.html.twig' %}
    {% include 'components/_modal_edit.html.twig' %}




{% endblock %}
